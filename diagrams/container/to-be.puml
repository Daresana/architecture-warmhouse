@startuml
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
title Тёплый дом — контейнеры To-Be
Person(user, "Владелец дома", "Выбирает модули и подключает устройства")
System_Ext(identity, "Провайдер идентификации", "Вход, JWT и публичные ключи")
System_Ext(devices, "Устройства партнёров", "Отопление, свет, ворота, камеры, новые датчики")
System_Boundary(home, "Тёплый дом — SaaS") {
 Container(web, "Веб-интерфейс", "React", "Каталог, подключение, управление, телеметрия, сценарии")
 Container(gateway, "API Gateway", "Nginx + JWT auth", "Проверка подписи; маршрутизация по module")
 Container(registry, "Реестр устройств", "Go, REST", "Дом, владелец, каталог, регистрация по коду, credentials/ACL")
 Container(telemetry, "Телеметрия", "Go, REST/MQTT", "Измерения и история; произвольные метрики из каталога")
 Container(scenarios, "Сценарии", "Go, REST/MQTT", "Условие по измерению и команда модулю")
 ContainerQueue(broker, "Брокер сообщений", "MQTT/TLS, QoS 1", "Команды, измерения, подтверждения; доступ к своим топикам")
 ContainerDb(rdb, "База реестра", "PostgreSQL", "Пользователи, дома, каталог и устройства")
 ContainerDb(tdb, "База телеметрии", "PostgreSQL", "Измерения; уникальный event_id")
 ContainerDb(sdb, "База сценариев", "PostgreSQL", "Правила и запуски")
 Container(heating, "Отопление", "Go, REST/MQTT", "Включение/выключение отопления; адаптер протокола, команды и состояние")
 ContainerDb(heatingdb, "База: отопление", "PostgreSQL", "Команды и подтверждённое состояние")
 Container(lighting, "Освещение", "Go, REST/MQTT", "Включение/выключение света; адаптер протокола, команды и состояние")
 ContainerDb(lightingdb, "База: освещение", "PostgreSQL", "Команды и подтверждённое состояние")
 Container(gates, "Ворота", "Go, REST/MQTT", "Запирание/отпирание ворот; адаптер протокола, команды и состояние")
 ContainerDb(gatesdb, "База: ворота", "PostgreSQL", "Команды и подтверждённое состояние")
 Container(monitoring, "Наблюдение", "Go, REST/MQTT", "Включение камеры и временная ссылка на видео; адаптер протокола, команды и состояние")
 ContainerDb(monitoringdb, "База: наблюдение", "PostgreSQL", "Команды и подтверждённое состояние")
}
Rel(user, web, "Личный кабинет", "HTTPS")
Rel(web, identity, "Вход", "OIDC/HTTPS")
Rel(web, gateway, "API с JWT", "HTTPS/JSON")
Rel(gateway, identity, "Получает публичные ключи", "HTTPS/JWKS")
Rel(gateway, registry, "Устройства и каталог", "HTTPS/REST")
Rel(gateway, telemetry, "Читает измерения", "HTTPS/REST")
Rel(gateway, scenarios, "Создаёт правила", "HTTPS/REST")
Rel(telemetry, registry, "Проверка доступа", "HTTPS/REST, timeout")
Rel(scenarios, registry, "Доступ к устройствам", "HTTPS/REST, timeout")
Rel(broker, telemetry, "Измерения telemetry/{id}", "MQTT/TLS")
Rel(broker, scenarios, "Измерения для правил", "MQTT/TLS")
BiRel(broker, devices, "commands/{id}, telemetry/{id}, state/{id}", "MQTT/TLS, device credentials")
Rel(registry, broker, "Учётные записи и ACL", "Management API/HTTPS")
Rel(monitoring, devices, "Временная ссылка на видео", "HTTPS, адаптер камеры")
Rel(web, devices, "Видеопоток по временной ссылке", "HTTPS")
Rel(registry, rdb, "Читает и пишет", "SQL")
Rel(telemetry, tdb, "Читает и пишет", "SQL")
Rel(scenarios, sdb, "Читает и пишет", "SQL")
Rel(gateway, heating, "module=heating", "HTTPS/REST")
Rel(heating, registry, "Проверка доступа", "HTTPS/REST, timeout")
Rel(scenarios, heating, "Команда по правилу", "HTTPS/REST")
BiRel(heating, broker, "Команды / подтверждения", "MQTT/TLS")
Rel(heating, heatingdb, "Читает и пишет", "SQL")
Rel(gateway, lighting, "module=lighting", "HTTPS/REST")
Rel(lighting, registry, "Проверка доступа", "HTTPS/REST, timeout")
Rel(scenarios, lighting, "Команда по правилу", "HTTPS/REST")
BiRel(lighting, broker, "Команды / подтверждения", "MQTT/TLS")
Rel(lighting, lightingdb, "Читает и пишет", "SQL")
Rel(gateway, gates, "module=gates", "HTTPS/REST")
Rel(gates, registry, "Проверка доступа", "HTTPS/REST, timeout")
Rel(scenarios, gates, "Команда по правилу", "HTTPS/REST")
BiRel(gates, broker, "Команды / подтверждения", "MQTT/TLS")
Rel(gates, gatesdb, "Читает и пишет", "SQL")
Rel(gateway, monitoring, "module=monitoring", "HTTPS/REST")
Rel(monitoring, registry, "Проверка доступа", "HTTPS/REST, timeout")
Rel(scenarios, monitoring, "Команда по правилу", "HTTPS/REST")
BiRel(monitoring, broker, "Команды / подтверждения", "MQTT/TLS")
Rel(monitoring, monitoringdb, "Читает и пишет", "SQL")
SHOW_LEGEND()
@enduml
