@startuml
title Тёплый дом — логическая модель данных
hide circle
skinparam nodesep 45
skinparam ranksep 60
package "База реестра" {
 entity User {
  * id : int <<PK>>
  --
  * identity_subject : varchar <<UK>>
  * name : varchar
  * email : varchar
 }
 entity House {
  * id : int <<PK>>
  --
  * user_id : int <<FK>>
  * name : varchar
  * address : varchar
 }
 entity Module {
  * id : int <<PK>>
  --
  * code : varchar <<UK>>
  * name : varchar
  * description : text
 }
 entity HouseModule {
  * house_id : int <<PK,FK>>
  * module_id : int <<PK,FK>>
  --
  * enabled : bool
 }
 entity DeviceType {
  * id : int <<PK>>
  --
  * module_id : int <<FK>>
  * name : varchar
  * manufacturer : varchar
  * protocol : varchar
  * commands : json
  * metrics : json
 }
 entity Device {
  * id : int <<PK>>
  --
  * house_id : int <<FK>>
  * type_id : int <<FK>>
  * serial_number : varchar <<UK>>
  * name : varchar
  * status : varchar
  * registered_at : timestamp
 }
}
package "База телеметрии" {
 entity TelemetryData {
  * id : bigint <<PK>>
  --
  * event_id : uuid <<UK>>
  * device_id : int <<reference>>
  * metric : varchar
  * value : decimal
  * unit : varchar
  * recorded_at : timestamp
 }
}
package "Отдельная база каждого сервиса управления" {
 entity DeviceState {
  * device_id : int <<PK,reference>>
  --
  * state : json
  * updated_at : timestamp
 }
 entity Command {
  * id : uuid <<PK>>
  --
  * device_id : int <<reference>>
  * user_id : int <<reference>>
  * name : varchar
  * parameters : json
  * status : varchar
  * created_at : timestamp
  confirmed_at : timestamp
 }
}
package "База сценариев" {
 entity Scenario {
  * id : int <<PK>>
  --
  * user_id : int <<reference>>
  * house_id : int <<reference>>
  * name : varchar
  * trigger_device_id : int <<reference>>
  * metric : varchar
  * operator : varchar
  * threshold : decimal
  * action_device_id : int <<reference>>
  * action_module : varchar
  * action_command : varchar
  * action_parameters : json
  * enabled : bool
  * last_condition : bool
 }
 entity ScenarioRun {
  * id : uuid <<PK>>
  --
  * scenario_id : int <<FK>>
  * event_id : uuid
  * command_id : uuid <<reference>>
  * status : varchar
  * created_at : timestamp
 }
}
User ||--o{ House : владеет
House ||--o{ Device : содержит
Module ||--o{ DeviceType : поддерживает
DeviceType ||--o{ Device : определяет тип
House ||--o{ HouseModule : выбирает
Module ||--o{ HouseModule : подключён
Device ||..o{ TelemetryData : измерения
Device ||..o| DeviceState : состояние
Device ||..o{ Command : команды
User ||..o{ Command : отправляет
User ||..o{ Scenario : создаёт
House ||..o{ Scenario : содержит
Device ||..o{ Scenario : условие
Device ||..o{ Scenario : действие
Scenario ||--o{ ScenarioRun : запуски
Command ||..o| ScenarioRun : действие
note bottom of ScenarioRun
 Уникальная пара (scenario_id, event_id).
 Стабильный command_id при повторной отправке.
end note
legend bottom
 Сплошная связь — локальный FK.
 Пунктир — логическая ссылка между базами.
 Command и DeviceState повторяются в каждой из четырёх баз модулей.
 Device.status — регистрация/связь; DeviceState — состояние прибора.
endlegend
@enduml
