@startuml
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
title Наблюдение — компоненты
Container(client, "Шлюз / сценарии", "REST", "Запрос с JWT и контекстом владельца")
Container(registry, "Реестр устройств", "REST", "Владелец, тип, протокол и разрешённые команды")
ContainerQueue(broker, "MQTT-брокер", "TLS", "commands/{id}, state/{id}; QoS 1")
ContainerDb(db, "База: наблюдение", "PostgreSQL", "Command, DeviceState")
System_Ext(camera, "Камера партнёра", "Доступ к видеопотоку по HTTPS")
Container_Boundary(service, "Наблюдение") {
 Component(api, "MonitoringController", "Go, REST", "POST /monitoring/devices/{id}/commands")
 Component(commands, "CommandService", "Go", "Включение камеры и временная ссылка на видео; проверка доступа и command_id")
 Component(adapter, "DeviceAdapter", "Go, MQTT", "Преобразует команды в протокол партнёра; ограниченные повторы публикации")
 Component(consumer, "StateConsumer", "Go, MQTT", "Подтверждение команды; фактическое состояние; timeout без подтверждения")
 Component(repository, "CommandRepository", "Go", "Команды и состояние; повторный ID не создаёт вторую команду")
}
Rel(client, api, "Отправляет команду", "HTTPS/JSON")
Rel(api, commands, "Проверяет и принимает", "Вызов")
Rel(commands, registry, "Проверяет владельца и тип; при ошибке не отправляет", "HTTPS/REST, timeout")
Rel(commands, repository, "Сохраняет команду; получает повтор", "Вызов")
Rel(commands, adapter, "Отправляет новую команду", "Вызов")
Rel(adapter, broker, "Публикует команду, retain=false", "MQTT/TLS, QoS 1")
Rel(adapter, camera, "Получает временную ссылку, привязанную к владельцу", "HTTPS")
Rel(broker, consumer, "Передаёт подтверждение", "MQTT/TLS")
Rel(consumer, repository, "Обновляет команду и состояние", "Вызов")
Rel(repository, db, "Читает и пишет", "SQL")
SHOW_LEGEND()
@enduml
